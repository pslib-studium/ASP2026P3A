@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Title</th>
            <th>Release Date</th>
            <th>Length (minutes)</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Items == null || !Model.Items.Any())
        {
            <tr>
                <td colspan="4">No movies found.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.Year</td>
                    <td>@item.Length</td>
                    <td>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
