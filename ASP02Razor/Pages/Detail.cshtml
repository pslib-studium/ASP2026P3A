@page
@{
    Layout = "_SpecialLayout";
}
@model ASP02Razor.Pages.DetailModel
@{
}

<p>@Model.Text</p>
@if (Model.Item == null)
{
    ViewData["Title"] = "?";
    <div class="alert alert-danger">Chyba: Jméno nebylo zadáno</div>
}
else
{
    ViewData["Title"] = @Model.Item.Name;
   <div class="alert alert-info">Jméno: @Model.Item.Name</div>
    <p>@Model.Item.Gender</p>
}
